{
  "name": "pagoscr",
  "version": "0.1.0",
  "private": true,
  "description": "Cobros de prueba y comparación de pasarelas para builders en Costa Rica",
  "license": "MIT",
  "author": "Vaniel González",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pagoscr-mcp": "./dist/mcp/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "skill",
    "plugin",
    "template",
    "docs",
    "evaluacion/tareas.json",
    "evaluacion/resultados",
    "evaluacion/evidencia",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup && node scripts/preparar-plugins.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "secretlint '**/*' && node scripts/check-secrets.mjs",
    "tarifas:check": "node scripts/validar-tarifas.mjs",
    "quickstart": "bash scripts/quickstart.sh",
    "quickstart:check": "bash scripts/quickstart.sh --check",
    "plugins:check": "node scripts/validar-plugins.mjs",
    "demo:checkout": "node dist/template/cli.js",
    "evaluacion:preparar": "node scripts/preparar-evaluacion.mjs",
    "evaluacion:reproducir": "node scripts/reproducir-evaluacion.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run secrets && npm run build && npm run tarifas:check && npm run quickstart:check && npm run plugins:check && npm run evaluacion:reproducir",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "secretlint": "^14.0.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
